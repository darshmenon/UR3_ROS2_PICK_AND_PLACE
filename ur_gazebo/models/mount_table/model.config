<?xml version="1.0"?>

<model>
  <name>mount_table</name>
  <version>1.0</version>
  <sdf version="1.5">model.sdf</sdf>

  <author>
    <name>Nate Koenig</name>
    <email>nate@osrfoundation.org</email>
  </author>

  <description>
    Wooden table (OpenRobotics Fuel model "Table", downloaded via
    `gz fuel download`) used as the arm's mounting surface. The
    tabletop collision/visual is centered (pose) at z=1.0m with a
    0.03m thickness, so its actual top FACE is at z=1.015m — that is
    the height the arm's base_joint must be raised to sit flush on
    top, not 1.0m (see table_height xacro arg in
    moveit_config/config/ur.urdf.xacro, default 1.015).
  </description>
</model>
