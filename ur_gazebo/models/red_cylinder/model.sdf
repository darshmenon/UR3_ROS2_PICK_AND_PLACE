<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="red_cylinder">
    <static>false</static>
    <link name="link">
      <inertial>
        <mass>0.100</mass>
        <inertia>
          <ixx>0.00102893</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00102893</iyy>
          <iyz>0</iyz>
          <izz>0.0000162</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.018</radius>
            <!-- Shortened from 0.35 so a top-down grasp at ~0.42m from the
                 UR3 base stays inside the arm's ~0.5m reach (see
                 mtc_node_params.yaml / README). Bumped 0.12->0.14 slightly
                 for perception testing — keep in sync with
                 mtc_node_params.yaml's object_dimensions and this model's
                 pose z in pick_and_place_demo.world. -->
            <length>0.14</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>5.0</mu>
              <mu2>5.0</mu2>
              <fdir1>0 0 1</fdir1>
              <slip1>0.0001</slip1>
              <slip2>0.0001</slip2>
            </ode>
            <torsional>
              <coefficient>0.1</coefficient>
              <surface_radius>0.015</surface_radius>
              <use_patch_radius>true</use_patch_radius>
            </torsional>
          </friction>
          <contact>
            <ode>
              <kp>1e5</kp>
              <kd>10</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
              <soft_cfm>0.01</soft_cfm>
              <soft_erp>0.2</soft_erp>
            </ode>
          </contact>
          <bounce>
            <restitution_coefficient>0.2</restitution_coefficient>
            <threshold>0.01</threshold>
          </bounce>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.018</radius>
            <!-- Shortened from 0.35 so a top-down grasp at ~0.42m from the
                 UR3 base stays inside the arm's ~0.5m reach (see
                 mtc_node_params.yaml / README). Bumped 0.12->0.14 slightly
                 for perception testing — keep in sync with
                 mtc_node_params.yaml's object_dimensions and this model's
                 pose z in pick_and_place_demo.world. -->
            <length>0.14</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 1</ambient>
          <diffuse>1.0 0.0 0.0 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
          <emissive>0.1 0 0 1</emissive>
        </material>
      </visual>
    </link>
  </model>
