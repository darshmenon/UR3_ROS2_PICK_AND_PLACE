<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="default">
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <gravity>0.0 0.0 -9.8</gravity>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>

    <!-- ================================================================
         Arm mount surface — arm's base_joint is raised by the same
         table_height (default 1.015, see ur.gazebo.launch.py) so it sits
         flush on top of mount_table's surface. Matches colored_blocks.world.
         ================================================================ -->
    <include>
      <name>mount_table</name>
      <uri>model://mount_table</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Flat work surface for the perception pipeline's plane segmentation to
         detect as the support surface — previously this world had objects
         floating directly above the bare ground plane with no distinct
         horizontal surface to fit, so get_planning_scene_server's RANSAC
         plane fit found nothing and MTC always fell back to a dummy object.
         Table bottom sits at table_height (1.015); top face at 1.055.
         2026-08-04: tried dropping this 0.285m below mount_table's surface
         to give the arm more top-down reach clearance (this height is only
         2cm above the robot's own base_link, a likely cause of the razor-thin
         collision-vs-no-IK grasp margins documented below). Reverted: the
         drop broke get_planning_scene_server's RANSAC — with the pick table
         no longer occluding it, the much larger mount_table plane (32k+
         points vs ~350 object points) won as "best fit" support surface
         instead, and the real fix (robust across whatever object geometry
         perception reports) belongs in the grasp strategy, not the scene —
         see the Fallbacks-based multi-candidate grasp in mtc_node.cpp. -->
    <model name="table">
      <static>true</static>
      <pose>0.275 0.04 1.035 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.30 0.45 0.04</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.30 0.45 0.04</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.6 0.4 1</ambient>
            <diffuse>0.8 0.6 0.4 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Red cylinder — reachable by UR3 arm. z raised so it rests on the
         table's top face (1.055) instead of the original bare ground (0).
         2026-08-04: x nudged +0.08m (0.22->0.30) further from the arm base —
         Universal Robots' own singularity documentation names this exact
         failure mode: a wrist forced into its q5=+-pi/2 singularity by a
         compact, close-to-base reach, which is consistent with the
         razor-thin collision-vs-no-IK grasp margins documented in
         mtc_node.cpp/README. Their recommended mitigations are (1) keep the
         task out of the base's "central cylinder" and (2) tilt the tool
         orientation off the singular alignment — this nudge is (1); the
         pitch-tilted candidates in mtc_node.cpp's Fallbacks ladder are (2).
         Stays well inside the table (0.125-0.425 span) and the UR3's ~0.5m
         reach while giving the wrist more room to angle into a top-down
         approach without folding in tight to the base. -->
    <include>
      <uri>model://red_cylinder</uri>
      <name>red_cylinder</name>
      <pose>0.30 0.12 1.255 0 0 0</pose>
    </include>

    <!-- YCB objects for richer scene — z raised the same way, x nudged
         further from the arm base for the same reason as red_cylinder above. -->
    <include>
      <uri>model://mustard</uri>
      <pose>0.39 0.09 1.135 0 0 0</pose>
    </include>

    <include>
      <uri>model://coke_can</uri>
      <pose>0.33 -0.10 1.13 0 0 0</pose>
    </include>

    <include>
      <uri>model://cheezit_big_original</uri>
      <pose>0.38 0.18 1.095 0 0 0</pose>
    </include>

    <!-- Bin / drop zone — sit on the raised ground (mount_table's floor
         level = table_height), not the pick table; outside its footprint. -->
    <model name="bin_left">
      <static>true</static>
      <pose>-0.15 0.25 1.015 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.01</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.15 0.15 0.01</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="bin_right">
      <static>true</static>
      <pose>-0.15 -0.25 1.015 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.01</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.15 0.15 0.01</size></box></geometry>
        </collision>
      </link>
    </model>

    <scene>
      <shadows>false</shadows>
    </scene>
  </world>
</sdf>
