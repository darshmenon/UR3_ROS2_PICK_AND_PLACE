<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="default">
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <gravity>0.0 0.0 -9.8</gravity>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>

    <!-- ================================================================
         Arm mount surface — arm's base_joint is raised by the same
         table_height (default 1.015, see ur.gazebo.launch.py) so it sits
         flush on top of mount_table's surface. Matches colored_blocks.world.
         ================================================================ -->
    <include>
      <name>mount_table</name>
      <uri>model://mount_table</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- 2026-08-07: removed the small pick "table" prop (was a 0.30x0.45x0.04
         box at 0.275 0.04 1.035, top face 1.055) that previously gave
         get_planning_scene_server's RANSAC plane fit a distinct horizontal
         surface to detect — without it, perception will find no support
         surface and MTC falls back to the dummy object / fallback
         collision box in mtc_node.cpp, same as before this prop existed.
         Objects below now rest directly on the raised ground (mount_table's
         floor, table_height=1.015) — z values dropped by 0.04m (the table's
         thickness) to land in the same place relative to that floor. -->

    <!-- Red cylinder — reachable by UR3 arm. z raised so it rests on the
         raised ground (table_height=1.015) instead of the original bare
         ground (0).
         2026-08-04: x nudged +0.08m (0.22->0.30) further from the arm base —
         Universal Robots' own singularity documentation names this exact
         failure mode: a wrist forced into its q5=+-pi/2 singularity by a
         compact, close-to-base reach, which is consistent with the
         razor-thin collision-vs-no-IK grasp margins documented in
         mtc_node.cpp/README. Their recommended mitigations are (1) keep the
         task out of the base's "central cylinder" and (2) tilt the tool
         orientation off the singular alignment — this nudge is (1); the
         pitch-tilted candidates in mtc_node.cpp's Fallbacks ladder are (2).
         2026-08-05: that +0.08m wasn't enough — live testing (see README)
         found the collision-vs-no-IK transition at this radius (~0.323m
         from base_link) is under 1mm wide across the whole Fallbacks ladder,
         i.e. still squarely inside the dead zone. Pushed diagonally (both x
         and y, not just x) to ~0.42m radius — a diagonal move buys more
         radial distance per mm of on-table budget than an x-only push,
         since the table's x span tops out at 0.425. Still comfortably
         inside the table (0.125-0.425 x, -0.185-0.245 y) and the UR3's
         ~0.5m reach. Not yet live-verified this is actually clear of the
         dead zone — the zone's radial extent isn't known, only that 0.323m
         is inside it. -->
    <include>
      <uri>model://red_cylinder</uri>
      <name>red_cylinder</name>
      <pose>0.36 0.0 1.075 0 0 0</pose>
    </include>

    <!-- YCB objects for richer scene — z raised the same way, x nudged
         further from the arm base for the same reason as red_cylinder above. -->
    <!-- Kept clear of red_cylinder (0.38, 0.18) so cylinder circle-fitting
         isn't swallowed by the mustard cluster / occluded from the head cam. -->
    <include>
      <uri>model://mustard</uri>
      <pose>0.25 0.20 1.095 0 0 0</pose>
    </include>

    <include>
      <uri>model://coke_can</uri>
      <pose>0.33 -0.10 1.09 0 0 0</pose>
    </include>

    <!-- Was at 0.38 0.18 — same XY as red_cylinder after the 2026-08-05
         base-distance push; moved to free table space so the two don't
         spawn interleaved and poison collision checks. -->
    <include>
      <uri>model://cheezit_big_original</uri>
      <pose>0.22 -0.12 1.055 0 0 0</pose>
    </include>

    <!-- Bin / drop zone — sit on the raised ground (mount_table's floor
         level = table_height), not the pick table; outside its footprint. -->
    <model name="bin_left">
      <static>true</static>
      <pose>-0.15 0.25 1.015 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.01</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.15 0.15 0.01</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="bin_right">
      <static>true</static>
      <pose>-0.15 -0.25 1.015 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.01</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.15 0.15 0.01</size></box></geometry>
        </collision>
      </link>
    </model>

    <scene>
      <shadows>false</shadows>
    </scene>
  </world>
</sdf>
