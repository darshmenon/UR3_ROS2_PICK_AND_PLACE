<?xml version="1.0" ?>
<!-- Empty floor + single red cylinder for pick-and-place MotionPlanning / MTC tests.
     No mount_table / pick table. Launch with table_height:=0.0 so the arm sits on z=0.
     Cylinder center z=0.06 = half of red_cylinder length (0.12 m) resting on ground. -->
<sdf version="1.7">
  <world name="default">
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <gravity>0.0 0.0 -9.8</gravity>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>

    <!-- Same XY as pick_and_place_demo (~0.36 m reach); z for table_height:=0.0 -->
    <include>
      <uri>model://red_cylinder</uri>
      <name>red_cylinder</name>
      <pose>0.36 0.0 0.06 0 0 0</pose>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>
  </world>
</sdf>
