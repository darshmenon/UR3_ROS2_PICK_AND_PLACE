<?xml version="1.0"?>
<package format="3">
  <name>ur_perception</name>
  <version>0.0.0</version>
  <description>Color and YOLO-based object detection and 3D pose estimation for UR pick-and-place</description>
  <maintainer email="darshmenon02@gmail.com">darshmenon</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>moveit_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>ur_interfaces</depend>
  <depend>ur_grasp</depend>
  <depend>std_srvs</depend>
  <depend>python3-scipy</depend>
  <depend>ament_index_python</depend>
  <exec_depend>rviz2</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
