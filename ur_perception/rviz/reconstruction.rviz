Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Saved Reconstruction1
        - /Live Reconstruction1
      Splitter Ratio: 0.5
    Tree Height: 549
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Saved Reconstruction
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Value: /ur_perception/ply_preview
      Color Transformer: RGB8
      Style: Flat Squares
      Size (Pixels): 3
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Live Reconstruction
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Value: /ur_perception/reconstructed_points
      Color Transformer: RGB8
      Style: Flat Squares
      Size (Pixels): 3
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.2
      Focal Point:
        X: 0.35
        Y: 0
        Z: 0.1
      Name: Current View
      Pitch: 0.6
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
  X: 60
  Y: 60
